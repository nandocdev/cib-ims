rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access unless explicitly granted
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for security, identity, and forensic compliance
    function isSignedIn() {
      return request.auth != null;
    }

    // Verification of authorized institutional officer
    function isCibOfficer() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.matches('.*@cib[.]gob[.]pa$')) ||
        (request.auth.token.email == 'fdocst@gmail.com')
      );
    }

    function isDirector() {
      return isSignedIn() && (
        request.auth.token.email == 'usuario1@cib.gob.pa' ||
        request.auth.token.email == 'fdocst@gmail.com'
      );
    }

    // Check if the case is currently in open status for modifications
    function isCaseOpen(caseCode) {
      return get(/databases/$(database)/documents/cases/$(caseCode)).data.status == 'ABIERTO';
    }

    // Sonda de verificación de conexión del cliente
    match /test/{docId} {
      allow read: if true;
    }

    // Colección: Usuarios del Buró Cibernético (/users/{userId})
    match /users/{userId} {
      allow read: if isCibOfficer();
      // Solo el propio usuario o el director pueden modificar datos de perfil
      allow write: if isCibOfficer() && (
        request.auth.uid == userId ||
        isDirector()
      );
    }

    // Colección: Casos y Expedientes Forenses (/cases/{caseCode})
    match /cases/{caseCode} {
      // Lectura permitida a todo el personal institucional del CIB
      allow read: if isCibOfficer();

      // Creación de nuevos casos: Solo agentes institucionales autorizados
      allow create: if isCibOfficer() &&
        request.resource.data.codigo == caseCode &&
        request.resource.data.status == 'ABIERTO';

      // Modificación e inmutabilidad:
      // Si el caso está en 'CERRADO', las actualizaciones ordinarias quedan bloqueadas
      // excepto reapertura formal autorizada por Dirección.
      allow update: if isCibOfficer() && (
        resource.data.status == 'ABIERTO' ||
        resource.data.status == 'EN_AUDITORIA' ||
        isDirector()
      );

      // Eliminación: Estrictamente bloqueada para salvaguardar la custodia procesal
      allow delete: if false;

      // Subcolección: Pista de Auditoría Encadenada (/cases/{caseCode}/audit_trail/{auditId})
      // INMUTABILIDAD ESTRICTA: Solo anexado (append-only); prohibida edición o borrado
      match /audit_trail/{auditId} {
        allow read: if isCibOfficer();
        allow create: if isCibOfficer();
        allow update, delete: if false;
      }

      // Subcolección: Artefactos de Evidencia (/cases/{caseCode}/evidence/{evidenceId})
      match /evidence/{evidenceId} {
        allow read: if isCibOfficer();
        allow create, update: if isCibOfficer() && (isCaseOpen(caseCode) || isDirector());
        allow delete: if false;
      }

      // Subcolección: Bitácora de 5 Días (/cases/{caseCode}/timeline/{dayNumber})
      match /timeline/{dayNumber} {
        allow read: if isCibOfficer();
        allow create, update: if isCibOfficer() && (isCaseOpen(caseCode) || isDirector());
        allow delete: if false;
      }

      // Subcolección: Interrogatorios y Preguntas Capciosas (/cases/{caseCode}/interrogations/{questionId})
      match /interrogations/{questionId} {
        allow read: if isCibOfficer();
        allow create, update, delete: if isCibOfficer() && (isCaseOpen(caseCode) || isDirector());
      }
    }

    // Colección: Normativas y Jurisprudencia (/regulations/{regId})
    match /regulations/{regId} {
      allow read: if true; // Leyes y gacetas oficiales de la República de Panamá son de acceso público
      allow write: if isDirector();
    }
  }
}
